{
  "$schema": "https://unpkg.com/wrangler@4.128.0/config-schema.json",
  "name": "xiaosang-portfolio",
  "account_id": "ef7863c4de93e71c3496f940c8ab4865",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "assets": {
    "directory": "./.cloudflare-build",
    "binding": "ASSETS",
    "run_worker_first": [
      "/xiaosang-gallery/media/*",
      "/xiaosang-gallery/originals/*",
      "/wujun-study/slides/*",
      "/wujun-study/static/*"
    ]
  },
  "routes": [
    {
      "pattern": "xiaosang.cc",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "node scripts/stage-cloudflare.mjs"
  },
  "main": "deploy/legacy-assets.mjs"
}
